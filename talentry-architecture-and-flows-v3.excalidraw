   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Zones are the parts of the system (browser, frontend, backend, career API, database, \u2605 agent worker, crawler, external). Each row is one user action or background job, read left \u2192 right.",
   "originalText": "Zones are the parts of the system (browser, frontend, backend, career API, database, \u2605 agent worker, crawler, external). Each row is one user action or background job, read left \u2192 right.",
