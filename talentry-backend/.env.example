# Copy to .env and fill in. .env is gitignored.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me"
PORT=3001

# Internal Python service that generates recommendations and interview prep.
CAREER_API_URL="http://localhost:8000"

# --- Google sign-in (optional; leave blank to disable) ---
# From https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
OIDC_ISSUER="https://accounts.google.com"
# Where Google redirects back to. Add this exact URL to the client's
# "Authorized redirect URIs" in the Google console.
REDIRECT_URL="http://localhost:3001/auth/google/callback"
# Where the API sends the browser after a successful login.
FRONTEND_URL="http://localhost:3000"
# Signs the short-lived OAuth session cookie. Generate like JWT_SECRET.
SESSION_SECRET="replace-me"
